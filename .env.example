NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only reporting writer. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_REPORTING_SERVICE_KEY=
APP_URL=http://localhost:3000
# Server-only provider credentials. Do not prefix with NEXT_PUBLIC_.
THENEWSAPI_TOKEN=
# Set true only after verifying this account permits Herald's public Briefings, PDFs, and archives.
THENEWSAPI_COMMERCIAL_APPROVED=false
# Optional supplementary CC BY 3.0 text feed. No API key; excludes media and ambiguous credits.
# Keep public output disabled until item rights and useful coverage have been reviewed.
GLOBALVOICES_ENABLED=false
GLOBALVOICES_PUBLIC_REPORTING_ENABLED=false
GEMINI_API_KEY=
# Set after checking a model with free-tier availability in AI Studio.
GEMINI_MODEL=
# Keep false until Herald's audience and Gemini's current API terms are compatible.
GEMINI_PUBLIC_BRIEFINGS_ENABLED=false

